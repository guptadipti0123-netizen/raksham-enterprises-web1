datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  TECHNICIAN
  CUSTOMER
}

enum AmcStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
  REGISTERED
}

enum ServiceRequestType {
  AMC_PRIORITY
  NON_AMC_PAID
}

enum ServiceRequestStatus {
  REQUEST_RECEIVED
  CUSTOMER_VERIFIED
  TECHNICIAN_ASSIGNED
  APPOINTMENT_CONFIRMED
  TECHNICIAN_ON_WAY
  IN_PROGRESS
  ESTIMATE_SENT
  COMPLETED
  CUSTOMER_CONFIRMED
  CLOSED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  SURVEY_SCHEDULED
  CONVERTED
  CLOSED
}

// 1. Users & Authentication
model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  name          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customer      Customer?
  technician    Technician?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

// 2. Customers (Housing Societies, Offices, Commercial Clients)
model Customer {
  id            String            @id @default(uuid())
  userId        String?           @unique
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerNo    String            @unique // e.g. 'ULV2601', 'CHE4819'
  name          String            // e.g. 'Silver Springs Residency CHS'
  contactPerson String?
  contactPhone  String
  email         String?
  address       String            @db.Text
  location      String            @default("Mumbai")
  amcStatus     AmcStatus         @default(ACTIVE)
  amcType       String            @default("Comprehensive Shield AMC")
  amcExpiry     DateTime?
  camerasCount  Int               @default(8)
  nvrDetails    String?           @default("Hikvision / CP Plus NVR 16CH")
  hddsDetails   String?           @default("4TB Surveillance HDD")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  serviceRequests ServiceRequest[]
  serviceReports  ServiceReport[]
  equipment       Equipment[]
  amcContracts    AmcContract[]

  @@index([customerNo])
  @@index([contactPhone])
  @@map("customers")
}

// 3. Technicians (Field Security Engineers)
model Technician {
  id             String           @id @default(uuid())
  userId         String?          @unique
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String           // e.g. 'Rakesh Toraskar'
  phone          String
  email          String?
  specialization String           @default("CCTV & IP Networking Specialist")
  hub            String           @default("Central Mumbai Hub")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())

  serviceRequests ServiceRequest[]
  serviceReports  ServiceReport[]

  @@map("technicians")
}

// 4. Enquiries (Website Contact & Free Survey Submissions)
model Enquiry {
  id              String        @id @default(uuid())
  enquiryNo       String        @unique // e.g. 'ENQ-4821'
  name            String
  mobile          String
  email           String?
  location        String        @default("Mumbai")
  propertyType    String        @default("Residential Society")
  serviceRequired String        @default("CCTV Installation")
  message         String?       @db.Text
  status          EnquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([mobile])
  @@map("enquiries")
}

// 5. Service Requests (AMC Priority & Non-AMC Paid Repairs)
model ServiceRequest {
  id                String               @id @default(uuid())
  ticketNo          String               @unique // e.g. 'AMC-20260825-412' or 'NAC-20260825-001'
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  contactPhone      String?
  location          String?
  serviceType       ServiceRequestType   @default(AMC_PRIORITY)
  issueType         String
  priority          String               @default("High (AMC Priority Queue)")
  status            ServiceRequestStatus @default(REQUEST_RECEIVED)
  reportedDate      DateTime             @default(now())
  technicianId      String?
  technician        Technician?          @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianName    String?              @default("Assigned Soon")
  technicianPhone   String?              @default("+91 90291 14205")
  scheduledTime     String?              @default("Within 4 Hours (AMC SLA)")
  visitCharge       Decimal              @default(0.00) @db.Decimal(10, 2)
  estimateParts     Json?                // JSON array of spare parts quoted
  estimateStatus    String?              @default("Pending") // 'Pending', 'Approved', 'Declined'
  customerConfirmed Boolean              @default(false)
  notes             String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  serviceReports    ServiceReport[]

  @@index([ticketNo])
  @@index([customerId])
  @@map("service_requests")
}

// 6. CCTV Service Reports (Raksham Verified PDF 1 Inspection Document)
model ServiceReport {
  id                     String           @id @default(uuid())
  reportId               String           @unique // e.g. 'REP-2026-0824'
  jobNo                  String           // e.g. 'JOB-9021'
  customerId             String?
  customer               Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName           String
  siteAddress            String           @db.Text
  contactPerson          String?
  contactNumber          String?
  serviceRequestId       String?
  serviceRequest         ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  technicianId           String?
  technician             Technician?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianName         String           @default("Rakesh Toraskar")
  serviceType            String           @default("Quarterly AMC Preventive Checkup")
  visitDate              DateTime         @default(now())
  complaintDetails       String?          @db.Text
  
  // Equipment Details
  systemType             String?          @default("HD IP Surveillance Network")
  brand                  String?          @default("Hikvision / CP Plus")
  modelNo                String?          @default("DS-7616NI-Q2 / NVR 16CH")
  serialNo               String?          @default("SN-HK8921-2024")
  noOfCameras            Int              @default(14)
  otherEquipment         String?          @default("PoE Switch 16-Port Gigabit, 4TB HDD")
  
  // Observations & Actions
  problemObserved        String?          @db.Text
  workCarriedOut         String?          @db.Text
  
  // 7-Point System Inspection Checklist
  systemHealth           String           @default("100% Operational")
  cctvHddStatus          String           @default("Healthy (Recording Active)")
  nvrFirmwareStatus      String           @default("Up to date")
  networkConnectivity    String           @default("Active (Static IP Online)")
  powerSupplyStatus      String           @default("12V SMPS Voltage Stable")
  recordingStatus        String           @default("Continuous 24x7 Active (30 Days)")
  remoteViewingStatus    String           @default("Hik-Connect Mobile Online")
  cameraAlignmentStatus  String           @default("All Angles Cleaned & Focused")
  
  // Remarks & Confirmations
  technicianRemarks      String?          @db.Text
  customerRemarks        String?          @db.Text
  customerConfirmed      Boolean          @default(true)
  technicianSignatureKey String?          // S3 Key for signature image
  customerSignatureKey   String?          // S3 Key for customer signature image
  
  // S3 Generated PDF Reference
  pdfS3Key               String?          // e.g. 'raksham/service-reports/REP-2026-0824.pdf'
  pdfUrl                 String?          @db.Text
  
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items                  ServiceReportItem[]
  photos                 ServiceReportPhoto[]
  amcServices            AmcService[]

  @@index([reportId])
  @@index([customerId])
  @@map("service_reports")
}

// 7. Service Report Items (Parts / Materials Used Table)
model ServiceReportItem {
  id              String        @id @default(uuid())
  serviceReportId String
  serviceReport   ServiceReport @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  itemNo          Int           @default(1)
  description     String        // e.g. 'BNC Connector Gold Plated' or '12V 5A Power Adapter'
  qty             Int           @default(1)
  remarks         String?       @default("Replaced under AMC Warranty")

  @@map("service_report_items")
}

// 8. Service Report Photos (S3 Stored Inspection Evidence)
model ServiceReportPhoto {
  id              String        @id @default(uuid())
  serviceReportId String
  serviceReport   ServiceReport @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  s3Key           String        // e.g. 'raksham/service-photos/photo_123.jpg'
  caption         String?       // e.g. 'DVR Rack after cleaning'
  createdAt       DateTime      @default(now())

  @@map("service_report_photos")
}

// 9. Equipment Inventory (CCTV Cameras, NVRs, Routers, Biometrics)
model Equipment {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  systemType     String    // 'IP CCTV', 'HD Analog CCTV', 'Biometric Access', 'Video Door Phone'
  brand          String    // 'Hikvision', 'CP Plus', 'Dahua', 'Matrix'
  model          String?
  serialNo       String?
  cameraCount    Int       @default(8)
  locationTag    String?   // 'Main Gate, Lobby, Lift, Parking'
  installDate    DateTime?
  warrantyExpiry DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@map("equipment")
}

// 10. AMC Contracts (Comprehensive & Non-Comprehensive Shield Contracts)
model AmcContract {
  id              String       @id @default(uuid())
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planName        String       @default("Comprehensive Shield AMC")
  startDate       DateTime
  endDate         DateTime
  frequency       String       @default("Quarterly (4 Preventive Visits/Year)")
  nextServiceDate DateTime?
  status          AmcStatus    @default(ACTIVE)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  amcServices     AmcService[]

  @@index([customerId])
  @@map("amc_contracts")
}

// 11. Scheduled AMC Preventive Visits
model AmcService {
  id              String         @id @default(uuid())
  amcContractId   String
  amcContract     AmcContract    @relation(fields: [amcContractId], references: [id], onDelete: Cascade)
  quarter         String         // 'Q1 - March', 'Q2 - June', 'Q3 - September', 'Q4 - December'
  scheduledDate   DateTime
  completedDate   DateTime?
  serviceReportId String?
  serviceReport   ServiceReport? @relation(fields: [serviceReportId], references: [id], onDelete: SetNull)
  status          String         @default("Scheduled") // 'Scheduled', 'Completed', 'Overdue'
  createdAt       DateTime       @default(now())

  @@map("amc_services")
}

// 12. In-App & SMS/WhatsApp Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("TICKET_UPDATE") // 'TICKET_UPDATE', 'AMC_REMINDER', 'REPORT_READY'
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// 13. Audit Logs (Security & Compliance Tracking)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // 'LOGIN_SUCCESS', 'CUSTOMER_CREATED', 'REPORT_GENERATED', 'ESTIMATE_APPROVED'
  resource  String   // 'auth', 'customers', 'service-reports'
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}
