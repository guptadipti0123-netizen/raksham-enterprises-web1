// =========================================================================
// RAKSHAM ENTERPRISES - RELATIONAL DATABASE SCHEMA (PRISMA ORM)
// Database Engine: MySQL (Local Development & Production Compatible)
// =========================================================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------------------

enum UserRole {
  ADMIN
  TECHNICIAN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AmcStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
  REGISTERED
}

enum ServiceRequestType {
  AMC_PRIORITY
  NON_AMC_PAID
  BREAKDOWN_REPAIR
  ROUTINE_INSPECTION
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ESTIMATE_SENT
  COMPLETED
  CLOSED
  CANCELLED
}

enum ServiceReportStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InspectionStatus {
  OK
  NOT_OK
  PENDING
  NOT_APPLICABLE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum EquipmentType {
  CCTV_CAMERA
  DVR
  NVR
  HDD
  ACCESS_CONTROL
  FIRE_ALARM
  BIOMETRIC
  VIDEO_DOOR_PHONE
  INTERCOM
  NETWORK_SWITCH
  POWER_SUPPLY
  OTHER
}

// -------------------------------------------------------------------------
// 1. USERS & AUTHENTICATION
// -------------------------------------------------------------------------
model User {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  mobile       String?       @unique
  passwordHash String        // bcrypt/argon2 hashed
  role         UserRole      @default(CUSTOMER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer      Customer?
  technician    Technician?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

// -------------------------------------------------------------------------
// 2. CUSTOMERS (Housing Societies, Commercial Buildings, Residential Sites)
// -------------------------------------------------------------------------
model Customer {
  id             String        @id @default(uuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  customerName   String        // e.g. 'Silver Springs Residency CHS'
  customerNumber String        @unique // e.g. 'ULV2601', 'CHEE2601'
  contactPerson  String?       // e.g. 'Mr. Deepak Sharma (Secretary)'
  contactNumber  String        // e.g. '+91 9867890606'
  email          String?
  siteAddress    String        @db.Text
  city           String        @default("Mumbai")
  state          String        @default("Maharashtra")
  pincode        String?
  status         AmcStatus     @default(ACTIVE)
  notes          String?       @db.Text
  
  // Quick Summary Fields
  camerasCount   Int           @default(8)
  amcType        String?       @default("Comprehensive Shield AMC")
  amcExpiry      DateTime?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  serviceRequests ServiceRequest[]
  serviceReports  ServiceReport[]
  equipment       Equipment[]
  amcContracts    AmcContract[]

  @@index([customerNumber])
  @@index([contactNumber])
  @@index([city])
  @@map("customers")
}

// -------------------------------------------------------------------------
// 3. TECHNICIANS (Field Engineers & Hub Technicians)
// -------------------------------------------------------------------------
model Technician {
  id             String        @id @default(uuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  name           String        // e.g. 'Rakesh Toraskar'
  phone          String
  email          String?
  specialization String        @default("CCTV & IP Networking Specialist")
  hub            String        @default("Central Mumbai Hub")
  status         UserStatus    @default(ACTIVE)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  serviceRequests ServiceRequest[]
  serviceReports  ServiceReport[]
  amcServices     AmcService[]

  @@map("technicians")
}

// -------------------------------------------------------------------------
// 4. ENQUIRIES (Website Contact & Survey Submissions)
// -------------------------------------------------------------------------
model Enquiry {
  id              String        @id @default(uuid())
  enquiryNumber   String        @unique // e.g. 'ENQ-4821'
  name            String
  mobile          String
  email           String?
  location        String        @default("Mumbai")
  serviceRequired String        @default("CCTV Installation")
  message         String?       @db.Text
  status          EnquiryStatus @default(NEW)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([mobile])
  @@index([status])
  @@map("enquiries")
}

// -------------------------------------------------------------------------
// 5. SERVICE REQUESTS (AMC Priority Complaints & Non-AMC Paid Tickets)
// -------------------------------------------------------------------------
model ServiceRequest {
  id                   String               @id @default(uuid())
  requestNumber        String               @unique // e.g. 'AMC-20260825-412' or 'NAC-20260825-001'
  customerId           String?
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  customerName         String
  contactNumber        String?
  location             String?
  
  assignedTechnicianId String?
  technician           Technician?          @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  technicianName       String?              @default("Assigned Soon")
  technicianPhone      String?              @default("+91 90291 14205")
  
  serviceType          ServiceRequestType   @default(AMC_PRIORITY)
  complaint            String               @db.Text
  priority             PriorityLevel        @default(HIGH)
  status               ServiceRequestStatus @default(PENDING)
  
  scheduledDate        DateTime?
  completedDate        DateTime?
  visitCharge          Decimal              @default(0.00) @db.Decimal(10, 2)
  
  estimateParts        Json?                // Quoted spare parts list
  estimateStatus       String?              @default("Pending")
  customerConfirmed    Boolean              @default(false)
  notes                String?              @db.Text
  
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  serviceReports       ServiceReport[]

  @@index([requestNumber])
  @@index([customerId])
  @@index([status])
  @@map("service_requests")
}

// -------------------------------------------------------------------------
// 6. SERVICE REPORTS (Raksham CCTV Service Report - PDF 1 Verification)
// -------------------------------------------------------------------------
model ServiceReport {
  id                   String              @id @default(uuid())
  reportNumber         String              @unique // e.g. 'REP-2026-0824'
  jobNo                String?             // e.g. 'JOB-9021'
  
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName         String
  customerNumber       String?
  siteAddress          String              @db.Text
  contactPerson        String?
  contactNumber        String?
  
  serviceRequestId     String?
  serviceRequest       ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  
  technicianId         String?
  technician           Technician?         @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianName       String              @default("Rakesh Toraskar")
  
  serviceDate          DateTime            @default(now())
  complaint            String?             @db.Text
  serviceType          String              @default("Quarterly AMC Preventive Checkup")
  
  // Equipment Details
  systemType           String?             @default("HD IP Surveillance Network")
  brand                String?             @default("Hikvision / CP Plus")
  model                String?             @default("DS-7616NI-Q2 / NVR 16CH")
  serialNumber         String?             @default("SN-HK8921-2024")
  numberOfCameras      Int                 @default(14)
  otherEquipment       String?             @default("PoE Switch 16-Port Gigabit, 4TB HDD")
  
  // Problem Observed & Work Carried Out
  problemObserved      String?             @db.Text
  workCarriedOut       String?             @db.Text
  
  // 8-Point CCTV System Inspection Checklist
  cctvHdd              InspectionStatus    @default(OK)
  dvrFirmware          InspectionStatus    @default(OK)
  networkConnectivity  InspectionStatus    @default(OK)
  powerSupply          InspectionStatus    @default(OK)
  recording            InspectionStatus    @default(OK)
  remoteViewing        InspectionStatus    @default(OK)
  cameraAlignment      InspectionStatus    @default(OK)
  cameraLensCleaning   InspectionStatus    @default(OK)
  inspectionRemarks    String?             @default("All 8 inspection checks operational and verified")
  
  // Remarks & Sign-off
  technicianRemarks    String?             @db.Text
  customerRemarks      String?             @db.Text
  customerConfirmed    Boolean             @default(true)
  customerSignature    String?             // Signature reference or data URI
  technicianSignature  String?             // Signature reference or data URI
  
  // PDF Document File Storage Reference (Local / S3)
  pdfFilePath          String?             // e.g. 'uploads/service-reports/REP-2026-0824.pdf'
  pdfUrl               String?             @db.Text
  
  status               ServiceReportStatus @default(COMPLETED)
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                ServiceReportItem[]
  photos               ServiceReportPhoto[]
  amcServices          AmcService[]

  @@index([reportNumber])
  @@index([customerId])
  @@index([status])
  @@map("service_reports")
}

// -------------------------------------------------------------------------
// 7. SERVICE REPORT ITEMS (Parts / Materials Used Table)
// -------------------------------------------------------------------------
model ServiceReportItem {
  id              String        @id @default(uuid())
  serviceReportId String
  serviceReport   ServiceReport @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  
  itemNumber      Int           @default(1)
  description     String        // e.g. 'BNC Connector Gold Plated' or '12V 5A Power Adapter'
  quantity        Int           @default(1)
  remarks         String?       @default("Replaced under AMC Warranty")

  @@map("service_report_items")
}

// -------------------------------------------------------------------------
// 8. SERVICE REPORT PHOTOS (Inspection Evidence Photos)
// -------------------------------------------------------------------------
model ServiceReportPhoto {
  id              String        @id @default(uuid())
  serviceReportId String
  serviceReport   ServiceReport @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  
  fileName        String
  filePath        String        // Local path or future S3 Key
  fileType        String?       @default("image/jpeg")
  uploadedBy      String?       @default("Technician")
  caption         String?       @default("Site inspection photo")
  
  createdAt       DateTime      @default(now())

  @@map("service_report_photos")
}

// -------------------------------------------------------------------------
// 9. EQUIPMENT (CCTV, NVR, Biometrics, Intercom, Fire Alarms Inventory)
// -------------------------------------------------------------------------
model Equipment {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  systemType       EquipmentType @default(CCTV_CAMERA)
  brand            String        // 'Hikvision', 'CP Plus', 'Dahua', 'Matrix'
  model            String?
  serialNumber     String?
  quantity         Int           @default(1)
  installationDate DateTime?
  status           String        @default("Operational") // 'Operational', 'Under Maintenance', 'Replaced'
  notes            String?       @db.Text
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId])
  @@map("equipment")
}

// -------------------------------------------------------------------------
// 10. AMC CONTRACTS (CCTV Annual Maintenance Contracts)
// -------------------------------------------------------------------------
model AmcContract {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  contractNumber   String        @unique // e.g. 'AMC-2025-081'
  planName         String        @default("Comprehensive Shield AMC")
  startDate        DateTime
  endDate          DateTime
  serviceFrequency String        @default("Quarterly (4 Preventive Visits/Year)")
  nextServiceDate  DateTime?
  status           AmcStatus     @default(ACTIVE)
  notes            String?       @db.Text
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  amcServices      AmcService[]

  @@index([customerId])
  @@index([status])
  @@map("amc_contracts")
}

// -------------------------------------------------------------------------
// 11. AMC SERVICES (Preventive Visit History & Execution)
// -------------------------------------------------------------------------
model AmcService {
  id               String         @id @default(uuid())
  amcContractId    String
  amcContract      AmcContract    @relation(fields: [amcContractId], references: [id], onDelete: Cascade)
  
  serviceReportId  String?
  serviceReport    ServiceReport? @relation(fields: [serviceReportId], references: [id], onDelete: SetNull)
  
  serviceDate      DateTime
  technicianId     String?
  technician       Technician?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  
  workPerformed    String?        @db.Text
  inspectionResult String?        @default("All 8 Points Passed")
  remarks          String?        @db.Text
  nextServiceDate  DateTime?
  status           String         @default("Completed") // 'Scheduled', 'Completed', 'Overdue'
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("amc_services")
}

// -------------------------------------------------------------------------
// 12. NOTIFICATIONS (In-App, SMS, WhatsApp Alert Tracking)
// -------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("TICKET_UPDATE") // 'TICKET_UPDATE', 'AMC_REMINDER', 'REPORT_READY'
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// -------------------------------------------------------------------------
// 13. AUDIT LOGS (Security, Admin & Compliance Activity Trail)
// -------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // 'ADMIN_CREATED_CUSTOMER', 'ADMIN_UPDATED_AMC', 'TECHNICIAN_COMPLETED_SERVICE', 'SERVICE_REPORT_CREATED'
  entity      String   // 'customers', 'service_requests', 'service_reports', 'amc_contracts'
  entityId    String?
  description String?  @db.Text
  ipAddress   String?  @default("127.0.0.1")
  
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}
