# =========================================================================
# RAKSHAM ENTERPRISES - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION (.env)
# =========================================================================

# 1. APPLICATION ENVIRONMENT & PORT
NODE_ENV=development
PORT=5000

# 2. LOCAL MYSQL DATABASE CONNECTION (PRISMA ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example for local MySQL:
DATABASE_URL="mysql://root:YOUR_LOCAL_MYSQL_PASSWORD@localhost:3306/raksham_db"

# 3. JWT AUTHENTICATION SECRET & EXPIRY
JWT_SECRET="raksham_local_dev_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# 4. CORS & FRONTEND URL
FRONTEND_URL="http://localhost:5173"

# 5. LOCAL FILE STORAGE PATH (For PDFs, Photos & Signatures)
LOCAL_UPLOAD_DIR="./uploads"

# 6. COMPANY METADATA
RAKSHAM_PHONE="+919867890606"
RAKSHAM_EMAIL="info@raksham.com"
