# =========================================================================
# RAKSHAM ENTERPRISES - BACKEND ENVIRONMENT CONFIGURATION (.env)
# =========================================================================

NODE_ENV=production
PORT=5000

# 1. DATABASE CONFIGURATION (MySQL / AWS RDS)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://raksham_admin:YourSecurePassword123!@raksham-db.c3xyz.ap-south-1.rds.amazonaws.com:3306/raksham_production"

# 2. JWT SECURITY & ENCRYPTION
JWT_SECRET="raksham_jwt_super_secret_production_key_replace_with_64_char_random"
JWT_EXPIRES_IN="7d"

# 3. AWS S3 PRIVATE FILE STORAGE (PDF Service Reports, Photos & Signatures)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIA_YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY_DO_NOT_COMMIT"
AWS_S3_BUCKET="raksham-production-storage"

# 4. CORS & DOMAIN WHITELISTS
FRONTEND_URL="https://raksham.com"
BACKEND_URL="https://api.raksham.com"

# 5. COMPANY BUSINESS METADATA
RAKSHAM_PHONE="+919867890606"
RAKSHAM_EMAIL="info@raksham.com"
